{
  "name": "bolvaani-vocalbridge",
  "version": "1.0.0",
  "description": "Voice-First Low-Literacy Assistant for Form Filling, Government Schemes & Job Applications",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "server:start": "npm --prefix server start",
    "client:build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
